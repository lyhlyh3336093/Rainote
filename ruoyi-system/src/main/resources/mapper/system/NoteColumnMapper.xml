<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.NoteColumnMapper">
    
    <resultMap type="NoteColumn" id="NoteColumnResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="type"    column="type"    />
        <result property="dwtableId"    column="dwtableId"    />
        <result property="property"    column="property"    />
        <result property="isShow"    column="isShow"    />
        <result property="sort"    column="sort"    />
    </resultMap>

    <sql id="selectNoteColumnVo">
        select id, name, type, dwtableId, property,isShow,sort from note_column
    </sql>

    <select id="selectNoteColumnList" parameterType="NoteColumn" resultMap="NoteColumnResult">
        <include refid="selectNoteColumnVo"/>
        <where>  
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="type != null "> and type = #{type}</if>
            <if test="dwtableId != null "> and dwtableId = #{dwtableId}</if>
            <if test="property != null  and property != ''"> and property = #{property}</if>
        </where>
        order by sort
    </select>

    <select id="selectNoteDoubleLinkColumnList" parameterType="Long" resultMap="NoteColumnResult">
        <include refid="selectNoteColumnVo"/>
        <where>
            <if test="dwtableId != null "> and dwtableId = #{dwtableId}</if>
             and type=21
        </where>
        order by sort
    </select>

    <select id="selectCalcColumnByDwtId" parameterType="Long" resultMap="NoteColumnResult">
        <include refid="selectNoteColumnVo"/>
        where type = 23
        <if test="dwtableId != null "> and dwtableId = #{dwtableId}</if>
        order by sort
    </select>

    <select id="selectSetColumnByDwtId" parameterType="Long" resultMap="NoteColumnResult">
        <include refid="selectNoteColumnVo"/>
        where type = 24
        <if test="dwtableId != null "> and dwtableId = #{dwtableId}</if>
        order by sort
    </select>
    
    <select id="selectNoteColumnById" parameterType="Long" resultMap="NoteColumnResult">
        <include refid="selectNoteColumnVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertNoteColumn" parameterType="NoteColumn" useGeneratedKeys="true" keyProperty="id">
        insert into note_column
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null">name,</if>
            <if test="type != null">type,</if>
            <if test="dwtableId != null">dwtableId,</if>
            <if test="property != null">property,</if>
            <if test="isShow != null">isShow,</if>
            <if test="sort != null">sort,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null">#{name},</if>
            <if test="type != null">#{type},</if>
            <if test="dwtableId != null">#{dwtableId},</if>
            <if test="property != null">#{property},</if>
            <if test="isShow != null">#{isShow},</if>
            <if test="sort != null">#{sort},</if>
         </trim>
    </insert>

    <update id="updateNoteColumn" parameterType="NoteColumn">
        update note_column
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="type != null">type = #{type},</if>
            <if test="dwtableId != null">dwtableId = #{dwtableId},</if>
            <if test="property != null">property = #{property},</if>
            <if test="isShow != null">isShow = #{isShow},</if>
            <if test="sort != null">sort = #{sort},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteNoteColumnById" parameterType="Long">
        delete from note_column where id = #{id}
    </delete>


    <delete id="deleteNoteColumnByDwtableId" parameterType="Long">
        delete from note_column where dwtableId = #{dwtableId}
    </delete>

    <delete id="removeAll" >
        delete from note_column where 1=1
    </delete>

    <delete id="deleteNoteColumnByIds" parameterType="String">
        delete from note_column where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectNoteColumnByIds" parameterType="String" resultMap="NoteColumnResult">
        <include refid="selectNoteColumnVo"/>
        where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
        order by sort
    </select>
</mapper>