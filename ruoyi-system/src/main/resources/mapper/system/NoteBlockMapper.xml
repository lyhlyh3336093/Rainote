<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.NoteBlockMapper">
    
    <resultMap type="NoteBlock" id="NoteBlockResult">
        <result property="id"    column="id"    />
        <result property="parentId"    column="parentId"    />
        <result property="childId"    column="childId"    />
        <result property="blockType"    column="blockType"    />
        <result property="property"    column="property"    />
        <result property="sort"    column="sort"    />
    </resultMap>

    <sql id="selectNoteBlockVo">
        select id, parentId, childId, blockType, property,sort from note_block
    </sql>

    <select id="selectNoteBlockList" parameterType="NoteBlock" resultMap="NoteBlockResult">
        <include refid="selectNoteBlockVo"/>
        <where>  
            <if test="parentId != null "> and parentId = #{parentId}</if>
            <if test="childId != null  and childId != ''"> and childId = #{childId}</if>
            <if test="blockType != null "> and blockType = #{blockType}</if>
            <if test="property != null  and property != ''"> and property = #{property}</if>
        </where>
        order by sort
    </select>
    
    <select id="selectNoteBlockById" parameterType="Long" resultMap="NoteBlockResult">
        <include refid="selectNoteBlockVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertNoteBlock" parameterType="NoteBlock" useGeneratedKeys="true" keyProperty="id">
        insert into note_block
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="parentId != null">parentId,</if>
            <if test="childId != null">childId,</if>
            <if test="blockType != null">blockType,</if>
            <if test="property != null">property,</if>
            <if test="sort != null">sort,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="parentId != null">#{parentId},</if>
            <if test="childId != null">#{childId},</if>
            <if test="blockType != null">#{blockType},</if>
            <if test="property != null">#{property},</if>
            <if test="sort != null">#{sort},</if>
        </trim>
    </insert>

    <update id="updateNoteBlock" parameterType="NoteBlock">
        update note_block
        <trim prefix="SET" suffixOverrides=",">
            <if test="parentId != null">parentId = #{parentId},</if>
            <if test="childId != null">childId = #{childId},</if>
            <if test="blockType != null">blockType = #{blockType},</if>
            <if test="property != null">property = #{property},</if>
            <if test="sort != null">sort = #{sort},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteNoteBlockById" parameterType="Long">
        delete from note_block where id = #{id}
    </delete>

    <delete id="removeAll" >
        delete from note_block where 1=1
    </delete>

    <delete id="deleteNoteBlockByIds" parameterType="String">
        delete from note_block where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>