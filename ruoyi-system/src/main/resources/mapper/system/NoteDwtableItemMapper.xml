<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.NoteDwtableItemMapper">
    
    <resultMap type="NoteDwtableItem" id="NoteDwtableItemResult">
        <result property="id"    column="id"    />
        <result property="dwtId"    column="dwtId"    />
        <result property="columnId"    column="columnId"    />
        <result property="value"    column="value"    />
        <result property="recordId"    column="recordId"    />
        <result property="linkRecordId"    column="linkRecordId"    />
        <result property="linkColumnId"    column="linkColumnId"    />
        <result property="linkItemId"    column="linkItemId"    />
        <result property="linkBlockId"    column="linkBlockId"    />
        <result property="linkNoteId"    column="linkNoteId"    />
    </resultMap>

    <sql id="selectNoteDwtableItemVo">
        select id, dwtId, columnId, value, recordId,linkRecordId,linkColumnId,linkItemId,linkBlockId,linkNoteId from note_dwtable_item
    </sql>

    <select id="selectNoteDwtableItemList" parameterType="NoteDwtableItem" resultMap="NoteDwtableItemResult">
        <include refid="selectNoteDwtableItemVo"/>
        <where>
            <if test="dwtId != null "> and dwtId = #{dwtId}</if>
            <if test="columnId != null "> and columnId = #{columnId}</if>
            <if test="value != null  and value != ''"> and value = #{value}</if>
            <if test="recordId != null  and recordId != ''"> and recordId = #{recordId}</if>
            <if test="linkRecordId != null  and linkRecordId != ''"> and #{linkRecordId} in linkRecordId</if>
            <if test="linkItemId != null  and linkItemId != ''"> and #{linkItemId} in linkItemId</if>
            <if test="linkColumnId != null  and linkColumnId != ''"> and linkColumnId = #{linkColumnId}</if>
            <if test="linkBlockId != null  and linkBlockId != ''"> and linkBlockId = #{linkBlockId}</if>
            <if test="linkNoteId != null  and linkNoteId != ''"> and linkNoteId = #{linkNoteId}</if>
        </where>
    </select>

    <select id="selectItemsByColumnIdWithLinkBlockId" parameterType="Long" resultMap="NoteDwtableItemResult">
        <include refid="selectNoteDwtableItemVo"/>
        where columnId = #{columnId} and linkBlockId is not null
    </select>
    
    <select id="selectNoteDwtableItemById" parameterType="Long" resultMap="NoteDwtableItemResult">
        <include refid="selectNoteDwtableItemVo"/>
        <where>
            <if test="dwtId != null "> and dwtId = #{dwtId}</if>
            <if test="columnId != null "> and columnId = #{columnId}</if>
            <if test="value != null  and value != ''"> and value = #{value}</if>
            <if test="recordId != null  and recordId != ''"> and recordId = #{recordId}</if>
            <if test="linkRecordId != null  and linkRecordId != ''"> and #{linkRecordId} in linkRecordId</if>
            <if test="linkColumnId != null  and linkColumnId != ''"> and linkColumnId = #{linkColumnId}</if>
            <if test="linkBlockId != null  and linkBlockId != ''"> and linkBlockId = #{linkBlockId}</if>
            <if test="linkNoteId != null  and linkNoteId != ''"> and linkNoteId = #{linkNoteId}</if>
        </where>
    </select>


    <select id="selectNoteDwtableItemByRecordAndColumn" parameterType="NoteDwtableItem" resultMap="NoteDwtableItemResult">
        <include refid="selectNoteDwtableItemVo"/>
        <where>
            <if test="dwtId != null "> and dwtId = #{dwtId}</if>
            <if test="columnId != null "> and columnId = #{columnId}</if>
            <if test="recordId != null  and recordId != ''"> and recordId = #{recordId}</if>
            <if test="linkRecordId != null  and linkRecordId != ''"> and #{linkRecordId} in linkRecordId</if>
            <if test="linkColumnId != null  and linkColumnId != ''"> and linkColumnId = #{linkColumnId}</if>
            <if test="linkBlockId != null  and linkBlockId != ''"> and linkBlockId = #{linkBlockId}</if>
            <if test="linkNoteId != null  and linkNoteId != ''"> and linkNoteId = #{linkNoteId}</if>
        </where>
    </select>


    <select id="selectNoteDwtableItemByRecordAndLinkColumn" parameterType="NoteDwtableItem" resultMap="NoteDwtableItemResult">
        <include refid="selectNoteDwtableItemVo"/>
        <where>
            <if test="dwtId != null "> and dwtId = #{dwtId}</if>
            <if test="columnId != null "> and columnId = #{columnId}</if>
            <if test="value != null  and value != ''"> and value = #{value}</if>
            <if test="recordId != null  and recordId != ''"> and recordId = #{recordId}</if>
            <if test="linkRecordId != null  and linkRecordId != ''"> and #{linkRecordId} in linkRecordId</if>
            <if test="linkColumnId != null  and linkColumnId != ''"> and linkColumnId = #{linkColumnId}</if>
            <if test="linkBlockId != null  and linkBlockId != ''"> and linkBlockId = #{linkBlockId}</if>
            <if test="linkNoteId != null  and linkNoteId != ''"> and linkNoteId = #{linkNoteId}</if>
        </where>
    </select>

    <!-- Excel 导入 U5/KTD3：双链对称写入的聚合读-改-写前置锁定（行不存在仅加间隙锁，锁内由调用方复核 upsert） -->
    <select id="selectNoteDwtableItemByRecordAndColumnForUpdate" parameterType="NoteDwtableItem" resultMap="NoteDwtableItemResult">
        <include refid="selectNoteDwtableItemVo"/>
        where recordId = #{recordId} and columnId = #{columnId}
        for update
    </select>

    <!-- Excel 导入 U5 入链重指向·写前锁读：updateLinkFieldsById 前 FOR UPDATE 重读现值再合并
         （防"捕获-落库"间隙的并发 UI 编辑丢失更新；行已被级联删除时返回 null，自然 no-op） -->
    <select id="selectNoteDwtableItemByIdForUpdate" parameterType="Long" resultMap="NoteDwtableItemResult">
        <include refid="selectNoteDwtableItemVo"/>
        where id = #{id}
        for update
    </select>
        
    <insert id="insertNoteDwtableItem" parameterType="NoteDwtableItem" useGeneratedKeys="true" keyProperty="id">
        insert into note_dwtable_item
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="dwtId != null">dwtId,</if>
            <if test="columnId != null">columnId,</if>
            <if test="value != null">value,</if>
            <if test="recordId != null">recordId,</if>
            <if test="linkRecordId != null">linkRecordId,</if>
            <if test="linkItemId != null">linkItemId,</if>
            <if test="linkColumnId != null">linkColumnId,</if>
            <if test="linkBlockId != null">linkBlockId,</if>
            <if test="linkNoteId != null">linkNoteId,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="dwtId != null">#{dwtId},</if>
            <if test="columnId != null">#{columnId},</if>
            <if test="value != null">#{value},</if>
            <if test="recordId != null">#{recordId},</if>
            <if test="linkRecordId != null">#{linkRecordId},</if>
            <if test="linkItemId != null">#{linkItemId},</if>
            <if test="linkColumnId != null">#{linkColumnId},</if>
            <if test="linkBlockId != null">#{linkBlockId},</if>
            <if test="linkNoteId != null">#{linkNoteId},</if>
         </trim>
    </insert>

    <!-- U5 扩展：link 字段列集（linkRecordId/linkItemId/linkColumnId，非关联 item 传 null）；
         useGeneratedKeys 回填自增 id（零缓冲不变量：对称写入的 linkItemId 须引用已落库的本表 item id） -->
    <insert id="insertNoteDwtableItems" parameterType="java.util.List" useGeneratedKeys="true" keyProperty="id">
        insert into note_dwtable_item (dwtId, columnId, recordId, value, linkRecordId, linkItemId, linkColumnId) values
        <foreach collection="list" item="item" separator=",">
            (#{item.dwtId}, #{item.columnId}, #{item.recordId}, #{item.value}, #{item.linkRecordId}, #{item.linkItemId}, #{item.linkColumnId})
        </foreach>
    </insert>

    <update id="updateNoteDwtableItem" parameterType="NoteDwtableItem">
        update note_dwtable_item
        <trim prefix="SET" suffixOverrides=",">
            <if test="dwtId != null">dwtId = #{dwtId},</if>
            <if test="columnId != null">columnId = #{columnId},</if>
            <if test="value != null">value = #{value},</if>
            <if test="recordId != null">recordId = #{recordId},</if>
            <if test="linkRecordId != null">linkRecordId = #{linkRecordId},</if>
            <if test="linkItemId != null">linkItemId = #{linkItemId},</if>
            <if test="linkColumnId != null">linkColumnId = #{linkColumnId} </if>
            <if test="linkBlockId != null">linkBlockId = #{linkBlockId} </if>
            <if test="linkNoteId != null">linkNoteId = #{linkNoteId} </if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteNoteDwtableItemById" parameterType="Long">
        delete from note_dwtable_item where id = #{id}
    </delete>


    <delete id="deleteNoteDwtableItemByDwtId" parameterType="Long">
        delete from note_dwtable_item where dwtId = #{dwtId}
    </delete>

    <delete id="deleteNoteDwtableItemByColumnId" parameterType="Long">
        delete from note_dwtable_item where columnId = #{columnId}
    </delete>

    <delete id="deleteNoteDwtableItemByRecordId" parameterType="Long">
        delete from note_dwtable_item where recordId = #{recordId}
    </delete>

    <delete id="removeAll" >
        delete from note_dwtable_item where 1=1
    </delete>

    <delete id="deleteNoteDwtableItemByIds" parameterType="String">
        delete from note_dwtable_item where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 替换式 Excel 导入（历史用途）：本表记录全删后，其他表指向本表的关联列（kept 21 配对列/他表 18 列）
         的 items 旧引用悬空，按列清空关联三字段（linkColumnId 保留标识配对方向）。
         导入路径已由 U5 入链重指向（重写取代整列清空）取代，现仅用于列级联删除链路 -->
    <update id="clearLinkFieldsByColumnId" parameterType="Long">
        update note_dwtable_item set linkRecordId = '', linkItemId = '', value = ''
        where columnId = #{columnId} and (linkRecordId is not null or linkItemId is not null)
    </update>

    <!-- U5 入链重指向·捕获：按表集合全量反查 linkRecordId 非空行（成员级"含某旧记录 id"的精确
         过滤由 Java 侧拆 CSV 串比对完成——查询侧同样禁 LIKE 子串匹配，id 3 会误中 13） -->
    <select id="selectLinkItemsByDwtIds" resultMap="NoteDwtableItemResult">
        <include refid="selectNoteDwtableItemVo"/>
        where linkRecordId is not null and linkRecordId != ''
        and dwtId in
        <foreach item="dwtId" collection="dwtIds" open="(" separator="," close=")">
            #{dwtId}
        </foreach>
    </select>

    <!-- U5 入链重指向·写路径：按主键单行更新三字段（Java 侧读-改-写：拆串→逐 id 映射→Set 去重→join
         后落库；禁集合式 SQL REPLACE——逗号串子串误替换，如旧 id 3 被 REPLACE 误中 13） -->
    <update id="updateLinkFieldsById">
        update note_dwtable_item set linkRecordId = #{linkRecordId}, linkItemId = #{linkItemId}, value = #{value}
        where id = #{id}
    </update>
</mapper>